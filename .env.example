# Safe development example only. Never commit real tokens or keys.
AMADEUS_ENVIRONMENT=development
AMADEUS_TELEGRAM_BOT_TOKEN=replace-with-development-bot-token
AMADEUS_ALLOWED_USER_IDS=123456789
AMADEUS_TELEGRAM_API_BASE_URL=https://api.telegram.org
AMADEUS_TELEGRAM_PROXY_URL=
# Safety gate: production run-v2 refuses to poll unless this is explicitly true.
AMADEUS_ENABLE_LONG_POLLING=false
# Separate safety gate: code deployment alone never activates long-horizon proactive messages.
AMADEUS_ENABLE_AUTONOMY_PILOT=false
# Separate safety gate for Phase 5.6.2 short-horizon delayed continuations / double-text.
AMADEUS_ENABLE_SPONTANEITY=false
# Optional read-only canon behavior references from data/v2/canon.jsonl.
AMADEUS_ENABLE_CANON_EXAMPLES=false
# Direct user-turn web search. The search provider is selected independently from the Character LLM.
# Web Search currently supports cpa|deepseek; Doubao is added as an LLM profile only.
AMADEUS_ENABLE_WEB_SEARCH=false
AMADEUS_WEB_SEARCH_PROVIDER=cpa
# Public GitHub feedback is a separate persistent side-effect capability and stays off by default.
# When enabled, the target remains hard-pinned in code to zhaocy02/tele-Amadeus.
AMADEUS_ENABLE_GITHUB_FEEDBACK=false
AMADEUS_GITHUB_APP_CLIENT_ID=
AMADEUS_GITHUB_APP_INSTALLATION_ID=
AMADEUS_GITHUB_APP_PRIVATE_KEY_PATH=
# IANA local-time basis used by autonomy and hosted Web Search relative-date anchoring.
AMADEUS_AUTONOMY_TIMEZONE=Asia/Shanghai

# CPA/Codex remains the default/primary Character LLM profile.
# Existing AMADEUS_PROVIDER_* names are retained for backward compatibility.
AMADEUS_LLM_PROVIDER=cpa
AMADEUS_PROVIDER_BASE_URL=http://127.0.0.1:8317/v1
AMADEUS_PROVIDER_API_KEY=replace-with-local-cpa-key
AMADEUS_PROVIDER_MODEL=gpt-5.6-sol
AMADEUS_PROVIDER_REASONING_EFFORT=high

# Optional manually selectable DeepSeek profile. Leave the key blank to keep this provider unavailable.
# Automatic provider failover is currently OFF; configuring this profile does not enable fallback.
AMADEUS_DEEPSEEK_BASE_URL=https://api.deepseek.com
AMADEUS_DEEPSEEK_API_KEY=
AMADEUS_DEEPSEEK_MODEL=deepseek-v4-pro
AMADEUS_DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
AMADEUS_DEEPSEEK_REASONING_EFFORT=high

# Optional manually selectable Doubao / Volcengine Ark Seed Evolving profile.
# Reuses the existing Responses adapter; no Volcengine SDK dependency is required.
AMADEUS_DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
AMADEUS_DOUBAO_API_KEY=
AMADEUS_DOUBAO_MODEL=doubao-seed-evolving
AMADEUS_DOUBAO_VISION_MODEL=doubao-seed-evolving
# Keep generic OpenAI-style reasoning payloads off; Ark owns its own thinking controls.
AMADEUS_DOUBAO_REASONING_EFFORT=none

AMADEUS_REQUEST_TIMEOUT_SECONDS=120

AMADEUS_PERSONA_DIR=./profiles/legacy_v1
AMADEUS_PERSONA_V2_PATH=./profiles/v2/persona_core.json
AMADEUS_DATA_DIR=./data
AMADEUS_MEMORY_DB=./data/amadeus-memory.sqlite
AMADEUS_RUNTIME_DB=./data/runtime.sqlite
AMADEUS_LOG_LEVEL=INFO
